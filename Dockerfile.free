FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    MODEL_MANIFEST_PATH=/app/models/edge-manifest.json \
    MODEL_PATH=/app/models/efficientnetb0_candidate.onnx \
    PORT=8000

WORKDIR /app
COPY requirements-api-free.txt ./
RUN pip install --no-cache-dir -r requirements-api-free.txt
COPY api ./api
COPY models/edge-manifest.json ./models/edge-manifest.json
COPY migrations ./migrations
COPY scripts ./scripts
COPY alembic.ini ./alembic.ini

CMD ["sh", "-c", "python -m alembic upgrade head && exec python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
